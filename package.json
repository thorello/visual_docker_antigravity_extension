{
  "name": "visual-server",
  "displayName": "Visual Server",
  "description": "Visual Server Manager for Antigravity",
  "version": "0.0.1",
  "publisher": "antigravity",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "visual-server-sidebar-container",
          "title": "Visual Server",
          "icon": "resources/icons/server-icon.svg"
        }
      ]
    },
    "views": {
      "visual-server-sidebar-container": [
        {
          "id": "visual-server-view",
          "name": "Antigravity Explorer",
          "icon": "resources/icons/server-icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "visualServer.openDashboard",
        "title": "Visual Server: Abrir Dashboard",
        "category": "Visual Server"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "package": "vsce package"
  },
  "dependencies": {
    "@vscode/webview-ui-toolkit": "^1.4.0",
    "ssh2": "^1.15.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/ssh2": "^1.11.19",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vscode/vsce": "^2.22.0",
    "eslint": "^8.0.0",
    "typescript": "^5.3.0"
  }
}
